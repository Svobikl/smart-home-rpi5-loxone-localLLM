# ~/.hermes/.env (chmod 600) — Smart Home & Local/Hybrid AI Configuration
HA_URL="http://localhost:8123"
HA_TOKEN="your_home_assistant_long_lived_token_here"

# Deye 15kW Hybrid Inverter (Solarman V5 Modbus TCP)
DEYE_IP="<DEYE_INVERTER_HOST>"
DEYE_LOGGER_SN="1234567890"

# Loxone Miniserver
LOXONE_IP="<LOXONE_MINISERVER_HOST>"
LOXONE_USER="your_loxone_user"
LOXONE_PSWD="your_loxone_password"

# Online AI APIs (Primary STT & Specialist Research/Implementation Routing)
GEMINI_API_KEY="your_gemini_api_key_here"
MINIMAX_API_KEY="your_minimax_api_key_here"

# Telegram Bot Gateway (Hermes Gateway real-time token streaming)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_TOKEN="your_telegram_bot_token_here"
TELEGRAM_ALLOWED_USERS="your_telegram_user_id"
